From 682b821f99b82a63756e8327df26d9a4e0ffe43f Mon Sep 17 00:00:00 2001
From: Facilis Bot <dev@facilis.local>
Date: Wed, 28 Oct 2026 19:05:33 +0000
Subject: [PATCH] fix(runtime): import.meta.resolve returns a URL, not a path

Node's import.meta.resolve returns a URL string: file://... for a module on disk
and node:fs for a core builtin. The ESM prelude handed back whatever
require.resolve returned - a bare filesystem path - so code doing
fileURLToPath(import.meta.resolve(...)) threw "Invalid URL" on a module that had
resolved perfectly. Nitro's node-worker/node-process dev runners are the case
that surfaced it (their entry lookup goes through exactly that call).

Build the file: URL from the resolved path, percent-encoding each segment, and
prefix node: for builtins, matching Node for the specifiers tools actually pass.

Offline regression: scripts/spike-bun-offline.mjs now pins the file, bare-package
and builtin forms; without this change those three checks fail.
---
 .changeset/quiet-meta-resolves.md |  5 +++++
 packages/runtime/esm.js           |  9 ++++++++-
 scripts/spike-bun-offline.mjs     | 17 +++++++++++++++++
 3 files changed, 30 insertions(+), 1 deletion(-)
 create mode 100644 .changeset/quiet-meta-resolves.md

diff --git a/.changeset/quiet-meta-resolves.md b/.changeset/quiet-meta-resolves.md
new file mode 100644
index 0000000..1736d69
--- /dev/null
+++ b/.changeset/quiet-meta-resolves.md
@@ -0,0 +1,5 @@
+---
+"@vivari/core": patch
+---
+
+Runtime: `import.meta.resolve()` now returns a URL string (`file://…` for modules, `node:…` for core builtins) like Node, instead of the bare filesystem path `require.resolve()` returns.
diff --git a/packages/runtime/esm.js b/packages/runtime/esm.js
index 1f56c43..5ff7a4a 100644
--- a/packages/runtime/esm.js
+++ b/packages/runtime/esm.js
@@ -106,7 +106,14 @@ export function importMetaSource(fileUrl, filename) {
     "const __oc_meta={url:" + J(fileUrl) +
       ",filename:" + J(fp) +
       ",dirname:" + J(dir) +
-      ",resolve:function(s){return __oc_require.resolve?__oc_require.resolve(s):s;}};" +
+      // Node's import.meta.resolve returns a URL STRING (file://… for a file, node:fs for
+      // a builtin), not the path require.resolve hands back. Tools do
+      // fileURLToPath(import.meta.resolve(…)) and die on a bare path — Nitro's
+      // node-worker/node-process dev runners are the case that surfaced this.
+      ",resolve:function(s){var r=__oc_require.resolve?__oc_require.resolve(s):s;" +
+        "if(r.charAt(0)==='/')return 'file://'+r.split('/').map(encodeURIComponent).join('/');" +
+        "if(r.indexOf('node:')===0)return r;" +
+        "return 'node:'+r;}};" +
     "if(globalThis.Bun){" +
       // path/dir/file are Bun's names for filename/dirname/basename. `.file` is
       // the basename WITH its extension ("index.tsx"), per Bun's docs.
diff --git a/scripts/spike-bun-offline.mjs b/scripts/spike-bun-offline.mjs
index 417dad2..928a53b 100644
--- a/scripts/spike-bun-offline.mjs
+++ b/scripts/spike-bun-offline.mjs
@@ -1851,6 +1851,23 @@ console.log("== import.meta: the Node members are unconditional, Bun's are gated
   const nodeMeta = evalMeta(src, stubRequire, entry);
   ok(nodeMeta.url === "file:///app/src/index.ts" && nodeMeta.filename === "/app/src/index.ts", "url + filename unchanged for a plain node process");
   ok(nodeMeta.dirname === "/app/src" && typeof nodeMeta.resolve === "function", "dirname + resolve unchanged too");
+
+  // Node parity: resolve() returns a URL string, not the path require.resolve gives.
+  // The loader's own prelude used to hand back the path, so code that does
+  // fileURLToPath(import.meta.resolve(…)) — Nitro's node-worker/node-process runners,
+  // among others — threw "Invalid URL" on a perfectly resolvable module.
+  const urlRequire = () => ({});
+  urlRequire.resolve = (s) =>
+    s === "fs" || s === "fs/promises"
+      ? s
+      : s === "./sibling.ts"
+        ? "/app/src/sibling.ts"
+        : "/app/node_modules/pkg/index.js";
+  const urlMeta = evalMeta(src, urlRequire, entry);
+  ok(urlMeta.resolve("./sibling.ts") === "file:///app/src/sibling.ts", "import.meta.resolve returns a file: URL for a relative specifier");
+  ok(urlMeta.resolve("pkg") === "file:///app/node_modules/pkg/index.js", "…and for a bare package specifier");
+  ok(urlMeta.resolve("fs") === "node:fs", "…and node: for a core builtin");
+  ok(urlMeta.resolve("fs/promises") === "node:fs/promises", "…including a builtin subpath");
   // The gate, stated as a behaviour: `import.meta.env` must NOT exist under node.
   // Vite SSR code reads `import.meta.env.MODE`; today that throws a TypeError it
   // can act on, and an always-on alias of process.env would make it read
