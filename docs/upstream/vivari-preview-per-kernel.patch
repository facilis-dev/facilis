+// frame whose owner is unknown (a revived SW has lost the map).
+function forwardOutboundFrame(d, sourceClientId) {
   if (kernelPort) {
     kernelPort.postMessage(d);
     return Promise.resolve();
   }
-  return findKernelClient().then((k) => {
