@@ -1095,13 +1137,10 @@ self.addEventListener("fetch", (event) => {
     const port = parseInt(slash === -1 ? rest : rest.slice(0, slash), 10);
     const stripped = (slash === -1 ? "/" : rest.slice(slash)) + url.search;
