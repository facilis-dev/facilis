# .env.example — generated from facilis.config.ts by `pnpm facilis:env --example` (D-224); do not edit by hand.
# Deployment values live in the `runtime` and `public` sections of facilis.config.ts (D-224).
# Copy to `.env` and uncomment the lines you need: every entry is a comment, so a copied file
# changes nothing, and no secret value is ever written here.

# Runtime — server surface: FACILIS_<KEY> overrides the declared value at boot.
# FACILIS_DATABASE_MODE=pglite
# FACILIS_DATABASE_URL=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_DEPLOYMENT_ID=
# FACILIS_EMAIL_WEBHOOK_TOKEN=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_EMAIL_WEBHOOK_URL=
# FACILIS_INITIAL_ADMIN=
# FACILIS_INITIAL_ADMIN_TOKEN=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_LOG_DIR=
# FACILIS_LOG_KEEP=5
# FACILIS_LOG_LEVEL=info
# FACILIS_LOG_MAX_BYTES=10485760
# FACILIS_LOG_SINK=auto
# FACILIS_LOG_TRUST_PROXY=false
# FACILIS_PUBLIC_ORIGIN=
# FACILIS_S3_ACCESS_KEY_ID=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_S3_BUCKET=
# FACILIS_S3_ENDPOINT=
# FACILIS_S3_FORCE_PATH_STYLE=
# FACILIS_S3_REGION=
# FACILIS_S3_SECRET_ACCESS_KEY=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_S3_SESSION_TOKEN=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_STATE_DIR=
# FACILIS_STORAGE_DRIVER=local
# FACILIS_STORAGE_ENCRYPTION_KEY=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_STORAGE_ENCRYPTION_KEY_ID=primary
# FACILIS_STORAGE_ENCRYPTION_RETIRED_KEYS=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_STORAGE_SECRET=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_TELEMETRY_ENABLED=false
# FACILIS_TELEMETRY_ENDPOINT=
# FACILIS_TELEMETRY_ORIGINS=[]
# FACILIS_TELEMETRY_SAMPLING=1
# FACILIS_TELEMETRY_SERVICE=facilis-app
# FACILIS_TELEMETRY_SPANS_PER_MIN=24
# FACILIS_TELEMETRY_TENANT_KEY=
#   required: a secret is read only from the environment; no value is written to git.
# FACILIS_TENANT_ID=00000000-0000-0000-0000-000000000000

