{
  "name": "@facilis/example-todo-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 acceptance app: hand-written todo app built only on the @facilis/* packages.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
