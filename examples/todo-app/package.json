  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@facilis/auth": "workspace:*",
    "@facilis/core": "workspace:*",
    "@facilis/db": "workspace:*",
    "@facilis/nitro": "workspace:*",
    "@facilis/time": "workspace:*",
    "@facilis/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nitro": "3.0.260903-beta",
    "react": "19.3.1",
    "react-router-dom": "7.18.5",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}