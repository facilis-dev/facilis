# Copy to .env for local AI work (dev only; .env is gitignored).
# When set, the DeepSeek preset is configured in dev so the chat needs no manual key.
VITE_DEEPSEEK_API_KEY=
# Optional: model for the dev seed (defaults to the preset's deepseek-chat).
# VITE_DEEPSEEK_MODEL=deepseek-chat
# Optional: base URL override for the dev seed.
# VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
