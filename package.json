{
  "name": "facilis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Facilis — a static, browser-based low-code framework. Monorepo root.",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && oxlint -c .oxlintrc.json . && node scripts/check-file-length.mjs && node scripts/check-ide-theme.mjs",
    "lint:file-length": "node scripts/check-file-length.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worktree": "node scripts/worktree.mjs",
    "test": "turbo run test --concurrency=2 -- --fsModuleCachePath=node_modules/.vitest-cache",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "release:status": "node scripts/release-status.mjs",
    "ide:dev": "pnpm --filter @facilis.dev/ide dev --port 5173",
    "ide:wasm": "sh scripts/dev/build-kernel-wasm.sh",
    "ide:assets": "sh scripts/dev/vendor-assets.sh",
    "ide:browser": "sh scripts/dev/fetch-browser.sh",
    "ide:smoke": "node scripts/dev/smoke-ide.mjs",
    "ide:smoke:multitab": "node scripts/dev/smoke-multitab.mjs",
    "lint:ide-theme": "node scripts/check-ide-theme.mjs",
    "pg:e2e": "node scripts/postgres-e2e.mjs",
    "ai:probe": "node --experimental-strip-types scripts/dev/ai-probe.mjs",
    "ai:probe:check": "node --experimental-strip-types scripts/dev/ai-probe-check.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  }
}
