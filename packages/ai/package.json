{
  "name": "@facilis.dev/ai",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis AI orchestration: prompt assembly, response parsing and patch validation.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@facilis.dev/analyze": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilis-dev/facilis.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/facilis-dev/facilis/tree/main/packages/ai#readme",
  "bugs": {
    "url": "https://github.com/facilis-dev/facilis/issues"
  },
  "keywords": [
    "facilis",
    "framework",
    "vite",
    "nitro",
    "low-code"
  ]
}
