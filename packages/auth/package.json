{
  "name": "@facilis.dev/auth",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis authentication and RBAC primitives: sessions, role expansion, permission checks.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.8.15",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "xml-crypto": "6.4.0"
  },
  "dependencies": {
    "@facilis.dev/db": "workspace:*",
    "@node-saml/node-saml": "5.2.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilis-dev/facilis.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/facilis-dev/facilis/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/facilis-dev/facilis/issues"
  },
  "keywords": [
    "facilis",
    "framework",
    "vite",
    "nitro",
    "low-code"
  ]
}
