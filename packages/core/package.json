{
  "name": "@facilis.dev/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis framework core: configuration contract, authorized-handler types and manifest shapes.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./i18n": "./src/i18n.ts",
    "./release": "./src/release-preview.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@facilis.dev/auth": "workspace:*",
    "@facilis.dev/db": "workspace:*",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilis-dev/facilis.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/facilis-dev/facilis/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/facilis-dev/facilis/issues"
  },
  "keywords": [
    "facilis",
    "framework",
    "vite",
    "nitro",
    "low-code"
  ]
}
