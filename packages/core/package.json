{
  "name": "@facilis/core",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis framework core: configuration contract, authorized-handler types and manifest shapes.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@facilis/auth": "workspace:*",
    "@facilis/db": "workspace:*",
    "zod": "4.6.7"
  }
}
