{
  "name": "@facilis/db",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis database layer: Drizzle + PGlite client, RLS policy helpers and release diffing.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.14",
    "drizzle-kit": "0.31.11",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "drizzle-orm": "0.45.4"
  }
}
