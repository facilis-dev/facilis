{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  // test-fixtures is typechecked with the tests; the shipped program (and its rootDir)
  // lives in tsconfig.build.json, which includes src only.
  "include": ["src/**/*.ts", "test-fixtures/**/*.ts"]
}
