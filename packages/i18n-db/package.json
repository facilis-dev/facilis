{
  "name": "@facilis.dev/i18n-db",
  "version": "0.0.0",
  "type": "module",
  "description": "database i18n: translated content fields plus an optional catalogue overlay",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@facilis.dev/core": "workspace:*",
    "@facilis.dev/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilis-dev/facilis.git",
    "directory": "packages/i18n-db"
  },
  "homepage": "https://github.com/facilis-dev/facilis/tree/main/packages/i18n-db#readme",
  "bugs": {
    "url": "https://github.com/facilis-dev/facilis/issues"
  },
  "keywords": [
    "facilis",
    "framework",
    "vite",
    "nitro",
    "low-code"
  ]
}
