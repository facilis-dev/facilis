{
  "name": "@facilis.dev/nitro",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis Nitro module and its Vite plugin wrapper.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/module.ts",
    "./session": "./src/session-cookie.ts",
    "./storage": "./src/storage.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nitro": "3.0.260903-beta",
    "oxlint": "catalog:",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nitro": "3.0.260903-beta",
    "vite": "8.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@facilis.dev/analyze": "workspace:*",
    "@facilis.dev/auth": "workspace:*",
    "@facilis.dev/core": "workspace:*",
    "@facilis.dev/db": "workspace:*",
    "@facilis.dev/storage": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facilis-dev/facilis.git",
    "directory": "packages/nitro"
  },
  "homepage": "https://github.com/facilis-dev/facilis/tree/main/packages/nitro#readme",
  "bugs": {
    "url": "https://github.com/facilis-dev/facilis/issues"
  },
  "keywords": [
    "facilis",
    "framework",
    "vite",
    "nitro",
    "low-code"
  ]
}
