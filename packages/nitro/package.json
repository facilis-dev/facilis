{
  "name": "@facilis/nitro",
  "version": "0.0.0",
  "type": "module",
  "description": "Facilis Nitro module and its Vite plugin wrapper.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/module.ts",
    "./session": "./src/session-cookie.ts",
    "./storage": "./src/storage.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nitro": "3.0.260903-beta",
    "oxlint": "catalog:",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "nitro": "3.0.260903-beta",
    "vite": "8.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@facilis/analyze": "workspace:*",
    "@facilis/auth": "workspace:*",
    "@facilis/core": "workspace:*",
    "@facilis/db": "workspace:*",
    "@facilis/storage": "workspace:*",
    "drizzle-orm": "0.45.4"
  }
}
