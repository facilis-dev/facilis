{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Packages export their src directly and are loaded by Node's native ESM loader (which
    // does type stripping but requires explicit extensions) when a Vite config imports them.
    // Relative imports therefore carry ".ts" and tsc rewrites them to ".js" on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Packages export their src (workspace protocol), so a consumer typechecks its
    // dependencies' sources: shared lib/types must therefore be uniform. Node globals are
    // needed by the server-side packages (fs/path/crypto); browser-only globals stay per-package.
    "types": ["node"]
  }
}
